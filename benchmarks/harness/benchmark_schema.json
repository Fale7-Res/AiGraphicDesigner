{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchmarkRunTelemetry",
  "type": "object",
  "required": [
    "run_id",
    "version_id",
    "timestamp_utc",
    "dataset_asset_id",
    "hardware_telemetry",
    "metrics",
    "verification_status"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^BENCH-[0-9]{8}-[0-9]{3}$"
    },
    "version_id": {
      "type": "string",
      "pattern": "^version-[0-9]{2}$"
    },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time"
    },
    "dataset_asset_id": {
      "type": "string",
      "pattern": "^(A[0-9]{2}|DS(12|30)-[EMHX][0-9]{2}|DS(12|30)-[0-9]{2})$"
    },
    "hardware_telemetry": {
      "type": "object",
      "required": [
        "device_type",
        "cpu_model",
        "ram_gb",
        "gpu_model",
        "vram_gb",
        "cuda_version",
        "os_platform"
      ],
      "properties": {
        "device_type": {"type": "string", "enum": ["LOCAL_GPU", "SERVERLESS_GPU", "CPU_EMULATED"]},
        "cpu_model": {"type": "string"},
        "ram_gb": {"type": "number"},
        "gpu_model": {"type": "string"},
        "vram_gb": {"type": "number"},
        "cuda_version": {"type": "string"},
        "os_platform": {"type": "string"}
      }
    },
    "metrics": {
      "type": "object",
      "required": [
        "trimap_boundary_iou",
        "lpips_score",
        "ssim_score",
        "max_bezier_node_count",
        "latency_seconds",
        "peak_vram_gb",
        "estimated_inference_cost_usd"
      ],
      "properties": {
        "trimap_boundary_iou": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "lpips_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "ssim_score": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "max_bezier_node_count": {"type": "integer", "minimum": 1},
        "latency_seconds": {"type": "number", "minimum": 0.0},
        "peak_vram_gb": {"type": "number", "minimum": 0.0},
        "estimated_inference_cost_usd": {"type": "number", "minimum": 0.0}
      }
    },
    "verification_status": {
      "type": "string",
      "enum": ["PENDING_EXECUTION", "VERIFIED_REAL_RUN", "REJECTED_FABRICATED"]
    },
    "reviewer_notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
